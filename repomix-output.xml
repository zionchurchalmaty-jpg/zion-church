/* Emoji styling within prose content - force inline display */
.prose img[alt*="emoji"],
.prose img[src*="emoji"],
.prose img[src*="twemoji"],
.prose img[src*="emojione"],
.prose img[src*="noto-emoji"],
.prose img[src*="cdnjs.cloudflare.com/ajax/libs/twemoji"],
.prose img[src*="cdn.jsdelivr.net/npm/emoji"],
.prose img[data-emoji],
.prose img.emoji,
